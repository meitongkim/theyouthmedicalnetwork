{
  "version": 1,
  "workflow": [
    "draft",
    "review",
    "published",
    "archived"
  ],
  "common": [
    {
      "key": "id",
      "label": "Stable ID",
      "type": "id",
      "required": true,
      "help": "Lowercase words joined by hyphens. Never change after publishing; other records and links refer to it."
    },
    {
      "key": "owner",
      "label": "Content owner",
      "type": "text",
      "required": true
    },
    {
      "key": "internalNotes",
      "label": "Internal notes",
      "type": "textarea",
      "internal": true,
      "help": "Never shown on the website."
    }
  ],
  "review": [
    {
      "key": "reviewer",
      "label": "Reviewer",
      "type": "text",
      "requiredToPublish": true
    },
    {
      "key": "reviewedAt",
      "label": "Reviewed on",
      "type": "date",
      "requiredToPublish": true
    },
    {
      "key": "reviewDue",
      "label": "Next review due",
      "type": "date",
      "required": true
    }
  ],
  "types": {
    "events": {
      "label": "Events",
      "title": "title",
      "group": "Website",
      "usedBy": "Not yet rendered (no events page). Published records feed the homepage “What’s next” list.",
      "fields": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "textarea",
          "required": true
        },
        {
          "key": "activityType",
          "label": "Activity type",
          "type": "select",
          "required": true,
          "options": [
            "Educational session",
            "Conversation",
            "Community service",
            "Campaign",
            "Other"
          ]
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "required": true,
          "options": [
            "In person",
            "Online",
            "Hybrid",
            "To be confirmed"
          ]
        },
        {
          "key": "start",
          "label": "Starts",
          "type": "datetime"
        },
        {
          "key": "end",
          "label": "Ends",
          "type": "datetime"
        },
        {
          "key": "timezone",
          "label": "Timezone",
          "type": "select",
          "options": [
            "",
            "Asia/Singapore (SGT, UTC+8)",
            "UTC"
          ]
        },
        {
          "key": "location",
          "label": "Location",
          "type": "text"
        },
        {
          "key": "organiser",
          "label": "Organiser",
          "type": "text",
          "required": true
        },
        {
          "key": "registrationStatus",
          "label": "Registration status",
          "type": "select",
          "required": true,
          "options": [
            "To be confirmed",
            "Not yet open",
            "Open",
            "Full",
            "Closed",
            "Postponed",
            "Cancelled"
          ]
        },
        {
          "key": "registrationUrl",
          "label": "Registration link",
          "type": "url"
        },
        {
          "key": "eligibility",
          "label": "Eligibility",
          "type": "textarea"
        },
        {
          "key": "access",
          "label": "Access information",
